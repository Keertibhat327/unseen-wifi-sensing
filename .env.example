DATABASE_URL=sqlite:///./sentinel.db
# Generate different long random values; never use these in a Vite env variable.
INGEST_API_KEY=replace-with-a-long-random-ingestion-key
READ_API_KEY=replace-with-a-different-long-random-dashboard-key
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
GATEWAY_API_URL=http://127.0.0.1:8000

# Alerts are opt-in. Mock mode never contacts Telegram; run the separate worker.
ALERT_MODE=off
ALERT_MAX_AGE_SECONDS=300
ALERT_MAX_ATTEMPTS=8
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
